# Public site URL (no trailing slash) — used for sitemap, OG, metadataBase
NEXT_PUBLIC_SITE_URL=https://niti.home

# Shopify Storefront (live site — safe to deploy these names, not values)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Or Headless private token (server-only, never NEXT_PUBLIC_):
# SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Must be true for live cart + checkout (see SHOPIFY_SETUP.md)
NEXT_PUBLIC_SHOPIFY_ENABLED=true

# --- Local catalog tooling ONLY (never required on Vercel) ---
# WP All Export XML feed URL (includes security_token). Never commit the real URL.
# VIKTORIJA_XML_URL=https://www.example.com/wp-load.php?security_token=…&export_id=…&action=get_data

# Dev Dashboard app — local import / catalog:diff --against=shopify only.
# Client ID + Secret from dev.shopify.com → your app → Settings.
# Scripts exchange these for a 24h Admin token. Never commit.
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# Legacy static Admin token (optional):
# SHOPIFY_ADMIN_ACCESS_TOKEN=
