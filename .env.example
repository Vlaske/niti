# Public site URL (no trailing slash) — sitemap, OG, metadataBase
# Set on Vercel (Production + Preview). Example: https://nitihome.rs
NEXT_PUBLIC_SITE_URL=https://nitihome.rs

# --- Shopify Storefront (required for live catalog + cart) ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Browser cart also needs the public domain (same value is fine):
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Preferred: Headless private token (server-only, never NEXT_PUBLIC_)
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Optional public token (or rely on NEXT_PUBLIC_SHOPIFY_ENABLED with private only)
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# Must be true for live cart/checkout when using a private server token
NEXT_PUBLIC_SHOPIFY_ENABLED=true

# Sale band on the homepage. false hides it. Omit to follow src/config/promo.ts
# NITI_PROMO_ENABLED=false

# --- Newsletter (Shopify Admin customer write) ---
# Required on Vercel if /api/newsletter should work in production
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Or legacy static Admin token:
# SHOPIFY_ADMIN_ACCESS_TOKEN=

# --- Local catalog tooling ONLY (not required on Vercel) ---
# VIKTORIJA_XML_URL=
